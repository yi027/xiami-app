# PostgreSQL connection string.
# PostgreSQL 連線字串。本機可先啟動 docker compose 的 postgres。
DATABASE_URL="postgresql://xiami:xiami@127.0.0.1:5432/xiami"

# Secret used to sign the login session cookie. Use at least 16 random characters.
# 用來簽署登入 cookie 的密鑰，至少 16 個隨機字元。
AUTH_SECRET="change-me-to-a-long-random-string"

# Public origin of this app. Used for links in invitation and close emails.
# 這個網站的公開網址，邀請信與結案信裡的連結會用到。
APP_URL="http://127.0.0.1:43123"

# Leave SMTP_HOST empty to log emails instead of sending them.
# SMTP_HOST 留空時，邀請信與結案信只寫進伺服器日誌，不會真的寄出，也不會讓操作失敗。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# File storage. local writes to disk. s3 uses any S3-compatible API
# (AWS S3, Cloudflare R2, GCS interoperability, MinIO).
# 檔案儲存。local 寫到磁碟。s3 可用任何 S3 相容服務。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads

# Required when STORAGE_DRIVER=s3.
# STORAGE_DRIVER=s3 時必填。
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set true for MinIO, Cloudflare R2, and most self-hosted endpoints.
# Path-style is the default when S3_ENDPOINT is set. Set false for virtual-hosted GCS or AWS.
# MinIO、Cloudflare R2 請設 true。有自訂 endpoint 時預設就是 path-style。AWS 官方或 GCS 虛擬主機樣式請設 false。
S3_FORCE_PATH_STYLE=
