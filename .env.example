# SQLite file. Relative to the prisma/ directory.
# SQLite 檔案位置，相對於 prisma/ 目錄。
DATABASE_URL="file:./dev.db"

# Secret used to sign the login session cookie. Use at least 16 random characters.
# 用來簽署登入 cookie 的密鑰，至少 16 個隨機字元。
AUTH_SECRET="change-me-to-a-long-random-string"

# Leave SMTP_HOST empty to log close-event emails instead of sending them.
# SMTP_HOST 留空時，結案信只寫進伺服器日誌，不會真的寄出，也不會讓結案失敗。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
